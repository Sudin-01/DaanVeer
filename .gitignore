# to remove already tracked files from git
# git rm --cached my_wallet.txt

# wallets and keys -- never commit
my_wallet.txt
*wallet*.txt
validator.txt

# chain state
db/
*.vlog
*.sst

# generated chain configuration (per-deployment; use -init to create)
config/chain.json

# local testbed state
experiments/.testbed/

# build artefacts
*.exe
daanveer

test.txt

# Research materials -- kept local until publication.
# docs/README.md is the public project README and stays tracked.
# Everything else under docs/ is research material that must not be published:
# the plan, the related-work survey, the paper source, and the original minor
# project. A blanket ignore with an explicit exception is used rather than a
# list of names, because `git add -A` twice swept in a file the list did not
# anticipate.
docs/*
!docs/README.md
